#===============================================================================
# choose c++ compiler
#===============================================================================
#CC= g++
CC=/opt/homebrew/bin/g++-16

#===============================================================================
# compiler flags
#===============================================================================
CXXFLAGS = -Wall -pedantic -O2
#CXXFLAGS = -Wall -pedantic -pg -O2
#CXXFLAGS = -Wall -pedantic -g -O1

#===============================================================================
# linker flags
#===============================================================================
LXXFLAGS =
#LXXFLAGS = -pg

#===============================================================================
# default lib path
#===============================================================================
#DEF_INC_PATH = /usr/local/include/
#DEF_LIB_PATH = /usr/local/lib/
#DEF_INC_PATH = /opt/local/include/
#DEF_LIB_PATH = /opt/local/lib/
DEF_INC_PATH = /opt/homebrew/include/
DEF_LIB_PATH = /opt/homebrew/lib/

#===============================================================================
# GSL lib
#===============================================================================
GSL_INC_PATH = $(DEF_INC_PATH)
GSL_LIB_PATH = $(DEF_LIB_PATH)
LIBSGSL = -L$(GSL_LIB_PATH) -lgsl -lgslcblas

#===============================================================================
# BOOST lib
#===============================================================================
BOOST_INC_PATH = $(DEF_INC_PATH)
BOOST_LIB_PATH = $(DEF_LIB_PATH)
LIBSBOOST = -L$(BOOST_LIB_PATH)

#===============================================================================
# (partial) openmp support
#===============================================================================
# If openmp support should be used uncomment next line and set the subsequent
# definitions accordingly.
#===============================================================================
USE_OPENMP   = -D OPENMP_ACTIVATED

ifeq ($(USE_OPENMP),-D OPENMP_ACTIVATED)
CXXFLAGS    += -fopenmp -pthread
LIBOPENMI    = -lgomp
endif

#===============================================================================
#===============================================================================
#===============================================================================
#
# below normally no changes should be necessary...
#
#===============================================================================
#===============================================================================
#===============================================================================


#===============================================================================
# passing the CosmoRec path on to the compiler
#===============================================================================
CXXFLAGSLOC = $(CXXFLAGS) $(USE_OPENMP)

#===============================================================================
# Required external libs
#===============================================================================
LIBS    = $(LIBSGSL) $(LIBSBOOST) $(LIBOPENMI) $(LIBSRF) -lm

#===============================================================================
# object files
#===============================================================================
OBJSDEV = $(TOOLS_DIR)/Simple_routines/routines.o \
       $(TOOLS_DIR)/Simple_routines/parser.o \
       $(TOOLS_DIR)/ODE_PDE_Solver/ODE_solver_LA.o \
       $(TOOLS_DIR)/ODE_PDE_Solver/ODE_solver.o \
	   $(TOOLS_DIR)/Compton_Kernel/Compton_Kernel.o \
       $(TOOLS_DIR)/Integration/Patterson.o \
       $(TOOLS_DIR)/Integration/Integration_routines.GSL.o \
       $(TOOLS_DIR)/Integration/Chebyshev_Int.o \
       $(TOOLS_DIR)/Cosmology/saikawa_shirai_gstar.o

OBJSCS = ./CSpack/CSpack_functions.o \
        ./CSpack/CSpack_kernels.o \
        ./CSpack/CSpack_kernel_moments.o \
        ./CSpack/CSpack_scattering_matrix.o \
        ./CSpack/CSpack_energy_losses.o \
        ./CSpack/CSpack_kernel_representation.o \
        ./CSpack/CSpack_weights.o \
        ./CSpack/CSpack_equilibrium_solutions.o

OBJS = $(OBJSDEV) $(OBJSCS)

#===============================================================================
# program 
#===============================================================================

all: CSpacklib CSpackmain

lib: CSpacklib

bin: CSpacklib CSpackmain

CSpackmain: CSpacklib CSpack_main.o
	   	@echo "\n Linking CSpack_main binary\n"
	   	$(CC) $(LXXFLAGS) CSpack_main.o -L. -lCSpack $(LIBS) -o CSpack_main

CSpacklib: $(OBJS)
		@echo "\n Creating CSpack library\n"
		ar rvs ./libCSpack.a $?
		@echo "\n done...\n";

#===============================================================================
# dependencies
#===============================================================================

#===============================================================================
# rules
#===============================================================================

INC_PATH = -I./CSpack -I$(TOOLS_DIR)/Definitions \
	   -I$(TOOLS_DIR)/Integration \
       -I$(TOOLS_DIR)/Compton_Kernel \
       -I$(TOOLS_DIR)/ODE_PDE_Solver \
       -I$(TOOLS_DIR)/Simple_routines \
       -I$(TOOLS_DIR)/Cosmology \
       -I/usr/local/include/ -I/opt/local/include/ \
       -I$(GSL_INC_PATH) -I.

.cpp.o:
	@echo "Producing object-file $@"
	$(CC) $(CXXFLAGSLOC) $(INC_PATH) -c $< -o $@
